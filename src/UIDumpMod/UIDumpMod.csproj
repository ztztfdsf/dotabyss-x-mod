<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UIDumpMod</AssemblyName>
    <RootNamespace>UIDumpMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS8632;CS0436;CS0618;CS8981</NoWarn>
  </PropertyGroup>

  <!--
    GameTree = 当前游戏版本的 apktool 解码树（已注入 LemonLoader）。
    编译引用它里面的 loader 程序集与 interop 代理 —— 必须是「当前版本重新生成的」interop，
    用旧版本的 interop 编译出的 dll 在新版本上会槽位错位、运行时崩溃。
    默认按工作区约定指向 repo 同级的 dl-1150.out；换版本 / 换机器时命令行覆盖：
      dotnet build -c Release -p:GameTree="D:\path\to\decoded-apk"
  -->
  <PropertyGroup>
    <GameTree Condition="'$(GameTree)'==''">$(MSBuildThisFileDirectory)..\..\..\dl-1150.out</GameTree>
    <LoaderDir>$(GameTree)\assets\LemonLoader\runtime\loader\net6</LoaderDir>
    <InteropDir>$(GameTree)\assets\LemonLoader\runtime\interop</InteropDir>
  </PropertyGroup>

  <Target Name="CheckGameTree" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(InteropDir)\Il2CppProject.dll')"
           Text="找不到 interop 代理：$(InteropDir)。请用 -p:GameTree=&lt;apktool 解码树&gt; 指定当前游戏版本的解码目录。" />
  </Target>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(LoaderDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(LoaderDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(LoaderDir)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(InteropDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(InteropDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
